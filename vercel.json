{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/lecturer",
      "destination": "/lecturer.html"
    },
    {
      "source": "/student",
      "destination": "/student.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
