# 1. Neon Serverless Postgres (Use POOLED connection containing '-pooler')
# Example: postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. JWT Cryptographic Signing Secret
JWT_SECRET=super_secure_sjce_jwt_secret_key_2026_change_in_production

# 3. Google Gemini AI Key for Alpine Smart Assistant (Optional)
GEMINI_API_KEY=

# 4. Port for local development
PORT=3000
